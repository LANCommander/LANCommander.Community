<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <PropertyGroup>
    <PluginDirectory>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'version.txt'))</PluginDirectory>
    <PluginVersion>$([System.IO.File]::ReadAllText('$(PluginDirectory)/version.txt').Trim())</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <PackageVersion>$(PluginVersion)</PackageVersion>
  </PropertyGroup>
</Project>
