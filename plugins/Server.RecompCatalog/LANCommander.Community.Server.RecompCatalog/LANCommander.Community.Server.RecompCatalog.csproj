<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>LANCommander.Community.Server.RecompCatalog</RootNamespace>
    <AssemblyName>LANCommander.Community.Server.RecompCatalog</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>LANCommander.Community.Server.RecompCatalog</PackageId>
    <Authors>Aaron Powell</Authors>
    <Description>Independent Quiver-compatible recompilation catalog browser and game importer for LANCommander Server.</Description>
    <PackageProjectUrl>https://github.com/LANCommander/LANCommander.Community/tree/main/plugins/Server.RecompCatalog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LANCommander/LANCommander.Community</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>LANCommander;plugin;server;recomp;catalog</PackageTags>
    <PackageType>LANCommander.Plugin;LANCommander.Plugin.Server</PackageType>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackPluginAssemblies</TargetsForTfmSpecificBuildOutput>
    <!-- Keep the git SHA out of the reported plugin version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The plugin is dropped into the server's Plugins folder; it serves no static web assets. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="LANCommander.Community.Server.RecompCatalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.Community.Server.RecompCatalog.Core\LANCommander.Community.Server.RecompCatalog.Core.csproj" />
    <ProjectReference Include="..\LANCommander.Community.Server.RecompCatalog.Infrastructure\LANCommander.Community.Server.RecompCatalog.Infrastructure.csproj" />
    <ProjectReference Include="..\LANCommander.Community.Server.RecompCatalog.Providers\LANCommander.Community.Server.RecompCatalog.Providers.csproj" />
  </ItemGroup>

  <!--
    Host contract and UI assemblies are compile-time only. The server already has them loaded, so the
    plugin must not ship private copies with conflicting type identities.
  -->
  <ItemGroup>
    <PackageReference Include="LANCommander.SDK" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.Plugins" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.UI" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <PluginAssembly Include="LANCommander.Community.Server.RecompCatalog.Core;LANCommander.Community.Server.RecompCatalog.Infrastructure;LANCommander.Community.Server.RecompCatalog.Providers" />
  </ItemGroup>

  <Target Name="PackPluginAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(PluginAssembly->'$(OutDir)%(Identity).dll')" />
    </ItemGroup>
  </Target>

</Project>
